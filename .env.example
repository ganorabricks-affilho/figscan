# Optional — app runs without any of these (mock catalog + local embeddings).

# BrickLink Catalog API (OAuth 1.0a). Official API only — do not scrape.
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN_VALUE=
BRICKLINK_TOKEN_SECRET=

# Optional hosted embeddings. The shipped mock index uses local vectors, so
# hosted providers are off unless you rebuild the index in the same space and set:
# SCANFIG_FORCE_OPENAI=1 or SCANFIG_FORCE_REPLICATE=1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SCANFIG_FORCE_OPENAI=
REPLICATE_API_TOKEN=
REPLICATE_EMBEDDING_MODEL=krthr/clip-embeddings
REPLICATE_EMBEDDING_VERSION=
SCANFIG_FORCE_REPLICATE=
